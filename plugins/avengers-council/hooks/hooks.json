{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "ExitPlanMode",
        "hooks": [
          {
            "type": "command",
            "command": "if [ -f \"${CLAUDE_PLUGIN_ROOT}/hooks/council-plan-hook.py\" ]; then python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/council-plan-hook.py\"; fi",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
