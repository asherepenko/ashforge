{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "if [ -f \"${CLAUDE_PLUGIN_ROOT}/hooks/track-progress.sh\" ]; then bash \"${CLAUDE_PLUGIN_ROOT}/hooks/track-progress.sh\"; fi",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "if [ -f \"${CLAUDE_PLUGIN_ROOT}/hooks/track-progress.sh\" ]; then bash \"${CLAUDE_PLUGIN_ROOT}/hooks/track-progress.sh\"; fi",
            "timeout": 10
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "startup|resume|clear",
        "hooks": [
          {
            "type": "command",
            "command": "if [ -f \"${CLAUDE_PLUGIN_ROOT}/hooks/session-start.py\" ]; then python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/session-start.py\"; fi",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
